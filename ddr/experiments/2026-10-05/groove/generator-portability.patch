+    private static void WriteFootworkTelemetry(PerformedChart chart, string sourceName, string difficulty)
+    {
+        var nodes = new List<object>();
+        for (var node = chart.GetRootNode(); node != null; node = node.Next)
+        {
+            if (node is not StepPerformanceNode step) continue;
+            var feet = new List<object>();
+            for (var foot = 0; foot < NumFeet; foot++)
+            {
+                for (var portion = 0; portion < NumFootPortions; portion++)
+                {
+                    var state = step.GraphNodeInstance.Node.State[foot, portion];
+                    var link = step.GraphLinkInstance?.GraphLink.Links[foot, portion];
+                    feet.Add(new {
+                        foot, portion, lane = state.Arrow, state = state.State.ToString(),
+                        moving = link?.Valid ?? false,
+                        step = link?.Valid == true ? link.Value.Step.ToString() : null,
+                        action = link?.Valid == true ? link.Value.Action.ToString() : null
+                    });
+                }
+            }
+            nodes.Add(new { row = node.Position, time = node.Time,
+                orientation = step.GraphNodeInstance.Node.Orientation.ToString(), feet });
+        }
+        var path = System.IO.Path.Combine(VisualizationDir, sourceName + "." + difficulty + ".footwork.json");
+        File.WriteAllText(path, System.Text.Json.JsonSerializer.Serialize(nodes,
+            new System.Text.Json.JsonSerializerOptions { WriteIndented = true }));
+    }
+
